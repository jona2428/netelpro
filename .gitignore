__pycache__/
*.pyc
.pytest_cache/
*.bak
.venv*/
*.egg-info/
dist/
build/
# Worktrees locales (SDD)
.worktrees/

# Teo v2: corpus binario y checkpoints regenerables (miles de MB)
data/**/*.bin
data/**/archive_*
data/**/*.log
data/**/dedup_state.json
data/**/shard_*.meta.json
models/teo_v2/
*.onnx
*.onnx.data
training/data/*.bin
training/data/teo_v2_corpus/
*token*.txt

# Corpus masivo empaquetado descargado de Kaggle (cientos de MB, supera el
# límite de 100MB de GitHub) — se regenera con training/data/build_massive_corpus.py
data/*.tar.gz
models/teo_sds/

# Kaggle run outputs: keep logs/evals/reports, never weights or repo snapshots
benchmarks/kaggle_out/**/*.safetensors
benchmarks/kaggle_out/**/*.npz
benchmarks/kaggle_out/**/*.llg
benchmarks/kaggle_out/**/netelpro_repo/
